{
  "name": "apuracao-bu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA para leitura de Boletins de Urna (QR Code, PDF, foto/OCR) e contabilização de votos com proteção contra duplicidade",
  "scripts": {
    "copy-assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run copy-assets",
    "dev": "vite",
    "dev:https": "vite --mode https --host",
    "prebuild": "npm run copy-assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@tesseract.js-data/por": "^1.0.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
